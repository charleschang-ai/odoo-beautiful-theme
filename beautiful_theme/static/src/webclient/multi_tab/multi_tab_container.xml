<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="beautiful_theme.MultiTabContainer">
        <div class="o_action_manager o_bt_mt_root">
            <!-- 标签栏（全屏动作时隐藏） -->
            <div t-if="!props.fullscreen and tabs.length" class="o_bt_tabbar d-print-none">
                <div class="o_bt_tabs_scroll">
                    <t t-foreach="tabs" t-as="tab" t-key="tab.id">
                        <div class="o_bt_tab"
                             t-att-class="{ o_bt_tab_active: state.activeId === tab.id }"
                             t-att-title="tab.name"
                             draggable="true"
                             t-on-dragstart="(ev) => this.onTabDragStart(ev, tab_index)"
                             t-on-dragover.prevent="() => {}"
                             t-on-drop="(ev) => this.onTabDrop(ev, tab_index)"
                             t-on-click="() => this.activateTab(tab.id)">
                            <img t-if="tab.icon" class="o_bt_tab_icon" t-att-src="tab.icon" t-att-alt="tab.name"/>
                            <span class="o_bt_tab_name" t-esc="tab.name"/>
                            <button class="o_bt_tab_close" title="Close"
                                    t-on-click.stop="() => this.closeTab(tab.id)">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                    </t>
                </div>

                <!-- 右侧功能菜单 -->
                <Dropdown>
                    <button class="o_bt_tabbar_menu" title="Tab actions">
                        <i class="fa fa-ellipsis-h"/>
                    </button>
                    <t t-set-slot="content">
                        <DropdownItem onSelected="() => this.reloadActiveTab()">
                            <i class="fa fa-refresh me-2"/>Reload current tab
                        </DropdownItem>
                        <DropdownItem onSelected="() => this.openInNewWindow()">
                            <i class="fa fa-external-link me-2"/>Open in a new browser tab
                        </DropdownItem>
                        <DropdownItem onSelected="() => this.closeOthers()">
                            <i class="fa fa-times-circle-o me-2"/>Close other tabs
                        </DropdownItem>
                        <DropdownItem onSelected="() => this.closeAll()">
                            <i class="fa fa-times-circle me-2"/>Close all tabs
                        </DropdownItem>
                    </t>
                </Dropdown>
            </div>

            <!-- 保活面板：全部挂载，非激活仅 CSS 隐藏 -->
            <div class="o_bt_panes">
                <t t-foreach="tabs" t-as="tab" t-key="tab.id">
                    <TabPane rt="_ensureRuntime(tab)" active="state.activeId === tab.id"/>
                </t>
            </div>

            <!-- 全局管理器的隐藏挂载：保证首次加载/命令面板等全局 doAction 正常 resolve -->
            <div class="o_bt_ghost" aria-hidden="true">
                <t t-if="state.ghost.Component"
                   t-component="state.ghost.Component"
                   t-props="state.ghost.componentProps"
                   t-key="state.ghost.id"/>
            </div>
        </div>
    </t>

</templates>
